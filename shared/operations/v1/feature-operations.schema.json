{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cultivationmmo.invalid/operations/v1/feature-operations.schema.json",
  "title": "FeatureOperationsV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "features"],
  "properties": {
    "schema_version": { "const": 1 },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_id",
          "inspect",
          "diagnose",
          "configure",
          "repair_reset",
          "phone_ui",
          "authorization",
          "audit",
          "verify"
        ],
        "properties": {
          "feature_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
          "inspect": { "$ref": "#/$defs/control" },
          "diagnose": { "$ref": "#/$defs/control" },
          "configure": { "$ref": "#/$defs/control" },
          "repair_reset": { "$ref": "#/$defs/control" },
          "phone_ui": { "$ref": "#/$defs/control" },
          "authorization": { "$ref": "#/$defs/control" },
          "audit": { "$ref": "#/$defs/control" },
          "verify": { "$ref": "#/$defs/control" }
        }
      }
    }
  },
  "$defs": {
    "control": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "method"],
          "properties": {
            "status": { "const": "local" },
            "method": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "maxLength": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "method", "reason"],
          "properties": {
            "status": { "const": "not_applicable" },
            "method": { "const": "" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
