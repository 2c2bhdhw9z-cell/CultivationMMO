{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cultivationmmo.invalid/owner-control/v1/privileged-command.schema.json",
  "title": "PrivilegedCommandDefinitionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command_id",
    "feature_id",
    "owning_service",
    "action",
    "requires_fresh_auth"
  ],
  "properties": {
    "command_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "feature_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "owning_service": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9._:-]+$" },
    "action": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9._:-]+$" },
    "requires_fresh_auth": { "type": "boolean" }
  }
}
