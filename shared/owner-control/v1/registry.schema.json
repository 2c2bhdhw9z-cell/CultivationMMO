{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cultivationmmo.invalid/owner-control/v1/registry.schema.json",
  "title": "PrivilegedCommandRegistryV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "status", "commands"],
  "properties": {
    "protocol": { "const": 1 },
    "status": { "const": "locked" },
    "commands": {
      "type": "array",
      "maxItems": 0,
      "items": { "$ref": "privileged-command.schema.json" }
    }
  }
}
